services:
  postgres:
    image: postgres:16
    restart: unless-stopped

    environment:
      POSTGRES_USER: sopiskill
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: sopiskill_dev

    ports:
      - "127.0.0.1:55432:5432"

    volumes:
      - sopiskill_pgdata:/var/lib/postgresql/data

    healthcheck:
      test: [ "CMD-SHELL", "pg_isready -U sopiskill -d sopiskill_dev" ]
      interval: 5s
      timeout: 5s
      retries: 10

volumes:
  sopiskill_pgdata:
